# The Sanity project ID and dataset are written into astro.config.mjs, so they aren't set here.

# Optional - A read token, used only when Visual Editing is on (to load unpublished drafts)
SANITY_API_READ_TOKEN=""
# Optional - The URL of your Sanity Studio. Defaults to http://localhost:3333
PUBLIC_SANITY_STUDIO_URL=""
# Optional - Visual Editing - set to "true" only locally, never on the live site
PUBLIC_SANITY_VISUAL_EDITING_ENABLED="false"
