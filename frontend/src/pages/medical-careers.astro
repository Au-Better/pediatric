---
// The careers roadmap moved into the families section. It now lives on whichever Studio page
// has "Interactive tool" set to the medical careers roadmap, so links to this old address are
// sent there, keeping any ?career=… choice. A temporary (302) redirect is used because the
// page can be moved again in the Studio.
import { getPages, pagePath } from "../utils/sanity";

const pages = await getPages();
const careersPage = pages.find((p) => p.tool === "careersRoadmap");

if (!careersPage) {
  return Astro.rewrite("/404");
}

return Astro.redirect(`${pagePath(careersPage, pages)}${Astro.url.search}`, 302);
---
