---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found — Au Better">
  <section class="mx-auto flex max-w-3xl flex-col items-start gap-4 px-5 pt-12 pb-16">
    <p class="text-sm font-bold tracking-widest text-ink/60">404</p>
    <h1 class="font-display text-5xl font-bold leading-tight text-brand-red">Page not found</h1>
    <p class="text-xl leading-relaxed text-ink/80">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a
      href="/"
      class="mt-2 rounded-full bg-brand-red px-6 py-3 font-display text-lg font-semibold text-cream no-underline transition-colors hover:bg-brand-red-dark"
    >
      ← Back to home
    </a>
  </section>
</Layout>
