---
import { PortableText } from "astro-portabletext";
import CodeBlock from "../components/CodeBlock.astro";
import CareerRoadmap from "../components/careers/CareerRoadmap";
import Layout from "../layouts/Layout.astro";
import { urlFor } from "../utils/image";
import { getPages, pagePath } from "../utils/sanity";

const pages = await getPages();
const path = `/${Astro.params.slug ?? ""}`;
const page = pages.find((p) => pagePath(p, pages) === path);

if (!page) {
  return Astro.rewrite("/404");
}

// A page with children works as a menu: each child is linked as a large button.
const children = pages.filter((p) => p.parentId === page._id);

const seoTitle = page.seo?.metaTitle || page.title || "Au Better";
const seoDescription = page.seo?.metaDescription || page.intro;
const ogImageSource = page.seo?.ogImage ?? page.mainImage;
const ogImage = ogImageSource
  ? urlFor(ogImageSource).width(1200).height(630).fit("crop").auto("format").quality(80).url()
  : undefined;

// A page can carry an interactive tool, picked in the Studio's "Interactive tool" field.
// The careers roadmap is wide, so its page header widens to line up with it.
const showsCareersRoadmap = page.tool === "careersRoadmap";
// A shared link can open the roadmap on a chosen career, for example ?career=nurse-practitioner
const initialCareer = Astro.url.searchParams.get("career") ?? undefined;
const initialCompare = Astro.url.searchParams.get("compare") ?? undefined;
---

<Layout title={seoTitle} description={seoDescription} image={ogImage}>
  <section
    class:list={[
      "mx-auto px-5 pt-10",
      showsCareersRoadmap ? "max-w-6xl pb-8" : "max-w-3xl pb-16",
    ]}
  >
    <h1 class="font-display text-5xl font-bold leading-tight text-brand-red md:text-6xl">
      {page.title}
    </h1>
    {
      page.intro && (
        <p class="mt-4 max-w-3xl text-xl leading-relaxed text-ink/80 md:text-2xl">{page.intro}</p>
      )
    }

    {
      page.mainImage && (
        <img
          class="mt-8 w-full rounded-3xl object-cover"
          src={urlFor(page.mainImage).width(1200).auto("format").quality(85).url()}
          width={page.mainImage.width}
          height={page.mainImage.height}
          alt={page.mainImage.alt || ""}
        />
      )
    }

    {
      children.length > 0 && (
        <nav class="mt-10 flex flex-col gap-4" aria-label={`${page.title} sections`}>
          {children.map((child) => (
            <a
              href={pagePath(child, pages)}
              class="rounded-full bg-brand-red px-8 py-5 text-center font-display text-2xl font-semibold text-cream no-underline transition-colors hover:bg-brand-red-dark"
            >
              {child.title}
            </a>
          ))}
        </nav>
      )
    }

    {
      page.body && (
        <div class="prose prose-lg mt-10 max-w-none prose-a:text-brand-red">
          <PortableText value={page.body} components={{ type: { code: CodeBlock } }} />
        </div>
      )
    }
  </section>

  {
    showsCareersRoadmap && (
      <CareerRoadmap client:load initialCareer={initialCareer} initialCompare={initialCompare} />
    )
  }
</Layout>
