---
import { VisualEditing } from "@sanity/astro/visual-editing";
import "../styles/global.css";
import { getSiteSettings } from "../utils/sanity";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;

// Every page names https://aubetter.org as its one true address, whichever address served it.
// Astro.site comes from `site` in astro.config.mjs.
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);

// Search engines may list a page only when BOTH are true:
// 1. "Show the site in search engines" is switched on in the Studio's Site settings, and
// 2. the page was served from the main address (not workers.dev, a preview link, or a local copy).
// If the setting can't be read, the page stays hidden rather than guessing.
let showInSearchEngines = false;
try {
  const settings = await getSiteSettings();
  showInSearchEngines = settings?.showInSearchEngines === true;
} catch {
  showInSearchEngines = false;
}
const servedFromMainAddress = Astro.url.hostname === "aubetter.org";
const hideFromSearchEngines = !(showInSearchEngines && servedFromMainAddress);

// For the footer's copyright line. Pages are built per visit, so this stays current.
const currentYear = new Date().getFullYear();

// Enable visual editing overlays when the env variable is set to "true"
const visualEditingEnabled =
  import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED === "true";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    {hideFromSearchEngines && <meta name="robots" content="noindex" />}

    <!-- Primary meta -->
    {description && <meta name="description" content={description} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {image && <meta property="og:image" content={image} />}

    <!-- Twitter -->
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {image && <meta name="twitter:image" content={image} />}

    <!-- Google fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <VisualEditing enabled={visualEditingEnabled} />
    <div class="flex min-h-dvh flex-col">
      <header class="px-5 py-4">
        <a href="/" class="inline-flex items-center gap-3 text-brand-red no-underline">
          <img src="/logo.png" alt="Au Better logo" class="h-16 w-auto" />
          <span class="font-display text-2xl font-bold">Au Better</span>
        </a>
      </header>
      <main class="flex-1">
        <slot />
      </main>
      <footer class="flex justify-end px-5 py-6">
        <p class="text-sm text-ink/70">© {currentYear} Au Better</p>
      </footer>
    </div>
  </body>
</html>
