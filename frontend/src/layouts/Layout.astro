---
import { VisualEditing } from "@sanity/astro/visual-editing";
import SiteMenu from "../components/SiteMenu.astro";
import "../styles/global.css";
import {
  SITE_NAME,
  SITE_URL,
  canonicalUrl,
  isListedInSearchEngines,
  jsonForScriptTag,
  structuredData,
  type PageInfo,
} from "../utils/seo";

interface Props {
  /** The full title for the browser tab and search results, such as "Finances — Au Better". */
  title: string;
  description?: string;
  image?: string;
  /** Alt text for `image` when it's shared. */
  imageAlt?: string;
  /**
   * True keeps search engines from listing this page, whatever the Studio setting says,
   * such as for a page that is still under development.
   */
  hideFromSearchEngines?: boolean;
  /** True on the "Page not found" page, which names no address of its own. */
  notFound?: boolean;
  /**
   * What the page is, for the structured data that search engines and AI tools read: its name
   * without the site's name, its kind and its breadcrumb trail. Leave out for a plain web page.
   */
  page?: Omit<PageInfo, "url" | "description">;
}

const {
  title,
  description,
  image,
  imageAlt,
  hideFromSearchEngines: hideThisPage = false,
  notFound = false,
  page,
} = Astro.props;

// Every page names https://aubetter.org as its one true address, whichever address served it,
// without a slash at the end (so /families and /families/ count as one page).
const canonicalURL = canonicalUrl(Astro.url.pathname);

// Search engines may list a page only when "Show the site in search engines" is switched on in
// the Studio's Site settings AND the page was served from the main address (see
// isListedInSearchEngines in utils/seo.ts). A page can also ask to stay hidden on its own (the
// hideFromSearchEngines prop), whatever the setting says.
const hideFromSearchEngines =
  hideThisPage || notFound || !(await isListedInSearchEngines(Astro.url));

// A page without its own share image uses the site's: the logo and name on cream.
const shareImage = image ?? `${SITE_URL}/og-image.png`;
const shareImageAlt = image ? imageAlt : "The Au Better logo and name in red on cream";

const jsonLd = structuredData({
  name: page?.name ?? title,
  kind: page?.kind,
  breadcrumbs: page?.breadcrumbs,
  description,
  url: canonicalURL,
});

// Enable visual editing overlays when the env variable is set to "true"
const visualEditingEnabled =
  import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED === "true";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta name="generator" content={Astro.generator} />
    {!notFound && <link rel="canonical" href={canonicalURL} />}
    {hideFromSearchEngines && <meta name="robots" content="noindex" />}
    <!-- Proves to Google Search Console that Au Better owns https://aubetter.org/. Keep it: removing it unverifies the site. -->
    <meta name="google-site-verification" content="7z2fI5lO2QqK2GbKJr7ywdOjwA-omDfV15bWEBrJTw8" />

    <!-- Primary meta -->
    {description && <meta name="description" content={description} />}

    <!-- Open Graph -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    {!notFound && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={shareImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    {shareImageAlt && <meta property="og:image:alt" content={shareImageAlt} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={shareImage} />
    {shareImageAlt && <meta name="twitter:image:alt" content={shareImageAlt} />}

    <!-- Structured data: who runs the site and what this page is, for search engines and AI -->
    <script is:inline type="application/ld+json" set:html={jsonForScriptTag(jsonLd)} />

    <!-- Google fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <VisualEditing enabled={visualEditingEnabled} />
    <div class="flex min-h-dvh flex-col">
      <header class="flex items-center justify-between gap-4 px-5 py-4">
        <a href="/" class="inline-flex items-center gap-3 text-brand-red no-underline">
          <img src="/logo.png" alt="" width="480" height="561" class="h-16 w-auto" />
          <span class="font-display text-2xl font-bold">Au Better</span>
        </a>
        <SiteMenu />
      </header>
      <main class="flex-1">
        <slot />
      </main>
      <footer class="flex justify-end px-5 py-6">
        <p class="flex items-center gap-1 text-sm text-ink/70">
          Made with <svg
            data-sanity-icon="heart-filled"
            width="1em"
            height="1em"
            viewBox="0 0 25 25"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              d="M17 16C15.8 17.3235 12.5 20.5 12.5 20.5C12.5 20.5 9.2 17.3235 8 16C5.2 12.9118 4.5 11.7059 4.5 9.5C4.5 7.29412 6.1 5.5 8.5 5.5C10.5 5.5 11.7 6.82353 12.5 8.14706C13.3 6.82353 14.5 5.5 16.5 5.5C18.9 5.5 20.5 7.29412 20.5 9.5C20.5 11.7059 19.8 12.9118 17 16Z"
              fill="currentColor"
              stroke="currentColor"
              stroke-width="1.2"></path></svg
          > at Sanity
        </p>
      </footer>
    </div>
  </body>
</html>
