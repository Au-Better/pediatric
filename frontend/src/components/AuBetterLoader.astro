---
// The Au Better logo drawing itself in red, over and over: three pen strokes, a short hold,
// then a fade before it starts again (a 2.8 second loop). It is decoration only, so screen
// readers skip it. People who ask their device for less motion see the finished logo, still.
// The styles are scoped to .ab-loader and the #ab-* ids, so they don't touch the rest of the page.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

