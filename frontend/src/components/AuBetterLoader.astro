  xmlns="http://www.w3.org/2000/svg"
  viewBox="14 14 440 532"
  class:list={["ab-loader", className]}
  aria-hidden="true"
  focusable="false"
>
  <style
    is:inline
    set:html={`.ab-loader g{animation:ab-f 2.8s linear infinite}.ab-loader path{fill:none;stroke:#ED1D27;stroke-width:9;stroke-linecap:round;stroke-linejoin:round;animation:2.8s linear infinite}#ab-a{stroke-dasharray:596 616;stroke-dashoffset:606;animation-name:ab-a}@keyframes ab-a{0%{stroke-dashoffset:606;animation-timing-function:cubic-bezier(.4,0,.6,1)}13.8%,100%{stroke-dashoffset:0}}#ab-b{stroke-dasharray:1098 1118;stroke-dashoffset:1108;animation-name:ab-b}@keyframes ab-b{0%,16.8%{stroke-dashoffset:1108;animation-timing-function:cubic-bezier(.4,0,.6,1)}42.1%,100%{stroke-dashoffset:0}}#ab-c{stroke-dasharray:730 750;stroke-dashoffset:740;animation-name:ab-c}@keyframes ab-c{0%,45.1%{stroke-dashoffset:740;animation-timing-function:cubic-bezier(.4,0,.6,1)}62.0%,100%{stroke-dashoffset:0}}@keyframes ab-f{0%,80%{opacity:1}93%,100%{opacity:0}}@media (prefers-reduced-motion:reduce){.ab-loader g,.ab-loader path{animation:none!important;opacity:1;stroke-dashoffset:0!important}}`}
