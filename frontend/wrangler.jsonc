{
  "name": "pediatric",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  // Turns off pediatric.jsoens27.workers.dev so the site has one public address.
  // aubetter.org is connected in the Cloudflare dashboard (Workers & Pages → pediatric → Domains)
  // and is not affected by this line.
  "workers_dev": false,
  // Daily visitor counts (no cookies, no IP addresses kept). See src/utils/visits.ts.
  // Tables are in migrations/; the daily totals are in the "daily" table and
  // visits by country, state and city are in the "locations" table.
  // Crawlers and scripts are left out; their page views are in the "skipped" table.
  // Where visits came from (Google, Bing, other sites, direct) is in the "sources" table.
  "d1_databases": [
    {
      "binding": "VISITS",
      "database_name": "aubetter-visits",
      "database_id": "5bf6969f-2944-4683-96fb-b9f3ab20df7c",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
